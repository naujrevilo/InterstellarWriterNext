{
  "$schema": "https://raw.githubusercontent.com/nicktomlin/tauri-v2-schema/main/capabilities.schema.json",
  "identifier": "default",
  "description": "Default capabilities for Interstellar Writer",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-read-dir",
    "fs:allow-stat"
  ]
}
